# ============================================
# LOCAL BUSINESS BACKEND - EXAMPLE .env FILE
# ============================================
# Copy this file to .env and update with your values
# NEVER commit .env to git!

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Option 1: Local MongoDB (Development)
MONGODB_URI=mongodb://localhost:27017/local-business

# Option 2: MongoDB Cloud Atlas (Production)
# Get this from MongoDB Atlas > Connect > Connect your application
MONGODB_CLOUD_URI=mongodb+srv://username:password@cluster-name.mongodb.net/local-business

# ============================================
# SECURITY
# ============================================

# Generate strong secret: 
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this

# ============================================
# ADMIN CREDENTIALS
# ============================================
# Change these immediately after deployment!

ADMIN_EMAIL=admin@salon.com
ADMIN_PASSWORD=admin123

# ============================================
# CORS CONFIGURATION
# ============================================

# Allow all origins (development only)
CORS_ORIGIN=*

# For production, specify your domain
# CORS_ORIGIN=https://yourdomain.com

# ============================================
# BUSINESS INFORMATION
# ============================================

BUSINESS_NAME=Premium Salon
BUSINESS_PHONE=+919876543210
BUSINESS_EMAIL=info@premiumsalon.com

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# For sending notifications and reminders

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# SMS OTP CONFIGURATION (Optional)
# ============================================
# Add a Fast2SMS authorization key to send real phone OTP messages.
# Without this key, signup OTP works in local testing by showing the OTP on the page.
FAST2SMS_API_KEY=

# ============================================
# BOOKING CONFIGURATION
# ============================================

# Maximum days in advance for booking
MAX_ADVANCE_BOOKING_DAYS=30

# Booking slot duration in minutes
BOOKING_SLOT_DURATION=30

# ============================================
# LOGGING
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# ============================================
# NOTES
# ============================================
# 
# 1. MONGODB_URI is for local development
# 2. MONGODB_CLOUD_URI is for production (MongoDB Atlas)
# 3. Use only ONE database URI at a time
# 4. Generate strong JWT_SECRET for production
# 5. Change ADMIN_EMAIL and ADMIN_PASSWORD
# 6. Add this file to .gitignore before committing
# 
# For MongoDB Atlas:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a free account
# 3. Create a cluster
# 4. Create a database user
# 5. Get connection string and paste as MONGODB_CLOUD_URI
FAST2SMS_API_KEY=your_fast2sms_key_here
